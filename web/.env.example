# Postgres connection string — auto-injected by the Vercel Neon integration
# once you accept its terms; only needed locally for `vercel dev`.
DATABASE_URL=

# Resend API key — auto-injected by the Vercel Resend integration once you
# accept its terms; only needed locally for `vercel dev`.
RESEND_API_KEY=

# Sender address for notification emails. Resend's shared onboarding@resend.dev
# works immediately with no setup but has low sending limits and worse
# deliverability; verify your own domain in the Resend dashboard when ready
# and switch this to e.g. "Influence <notify@yourdomain.com>".
NOTIFY_FROM_EMAIL="Influence <onboarding@resend.dev>"

# Shared secret Vercel Cron sends as a Bearer token so the backstop endpoint
# can tell a real cron invocation from a random internet request. Set the
# same value in the Vercel project's environment variables. Optional locally
# (the check is skipped if unset) but should be set in production.
CRON_SECRET=

# Privy app ID (from the Privy dashboard) — powers Twitter/email social login.
PRIVY_APP_ID=
